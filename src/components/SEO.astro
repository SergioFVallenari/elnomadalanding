---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title = "Posada El Nómada | Alojamiento en La Serranita, Córdoba",
  description = "Tu parada en el camino. Descansá y disfrutá las sierras en Posada El Nómada, La Serranita, Córdoba. Consultá disponibilidad y reservá online.",
  image = "/images/posada-og.jpg",
  imageAlt = "Posada El Nómada en La Serranita, Córdoba",
} = Astro.props;

const site = Astro.site ?? new URL("https://posadaelnomada.com.ar");
const canonical = new URL(Astro.url.pathname, site);
const imageUrl = new URL(image, site);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("/#website", site).href,
      url: site.href,
      name: "Posada El Nómada",
      inLanguage: "es-AR",
    },
    {
      "@type": "LodgingBusiness",
      "@id": new URL("/#posada", site).href,
      name: "Posada El Nómada",
      url: site.href,
      description:
        "Moto-posada y alojamiento para familias en La Serranita, Córdoba, Argentina.",
      image: imageUrl.href,
      address: {
        "@type": "PostalAddress",
        addressLocality: "La Serranita",
        addressRegion: "Córdoba",
        addressCountry: "AR",
      },
    },
  ],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />

<meta
  name="robots"
  content="index, follow, max-image-preview:large"
/>
<meta name="theme-color" content="#253D46" />

<!-- Vista previa al compartir -->
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_AR" />
<meta property="og:site_name" content="Posada El Nómada" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={imageUrl.href} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl.href} />
<meta name="twitter:image:alt" content={imageAlt} />

<script
  type="application/ld+json"
  set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
/>
