---
import { site, whatsappUrl } from '../config/site';
---

<nav class="floating-socials" aria-label="Redes sociales y contacto">
	<a class="social-link instagram" href={site.instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Visitá nuestro Instagram (abre en otra pestaña)" title="Seguinos en Instagram">
		<svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
			<rect x="3" y="3" width="18" height="18" rx="5" />
			<circle cx="12" cy="12" r="4" />
			<circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
		</svg>
	</a>
	<a class="social-link whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Escribinos por WhatsApp (abre en otra pestaña)" title="Escribinos por WhatsApp">
		<svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
			<path d="M20.52 3.48A11.88 11.88 0 0 0 12.05 0C5.47 0 .11 5.35.1 11.94c0 2.1.55 4.15 1.6 5.96L0 24l6.26-1.64a11.96 11.96 0 0 0 5.78 1.47h.01c6.58 0 11.94-5.35 11.95-11.94a11.87 11.87 0 0 0-3.48-8.41ZM12.05 21.8a9.9 9.9 0 0 1-5.06-1.38l-.36-.21-3.71.97.99-3.62-.24-.37a9.87 9.87 0 0 1-1.51-5.25c0-5.48 4.46-9.93 9.94-9.93a9.87 9.87 0 0 1 7.03 2.91 9.87 9.87 0 0 1 2.9 7.04c0 5.48-4.46 9.94-9.98 9.94Zm5.45-7.44c-.3-.15-1.76-.87-2.03-.97-.28-.1-.48-.15-.68.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.53.07-.8.37-.28.3-1.05 1.02-1.05 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.21 5.09 4.5.71.31 1.27.49 1.7.63.71.22 1.36.19 1.87.11.57-.08 1.76-.72 2.01-1.42.25-.7.25-1.3.18-1.42-.08-.13-.28-.2-.58-.35Z" />
		</svg>
	</a>
</nav>

<style>
	.floating-socials {
		position: fixed;
		right: max(18px, env(safe-area-inset-right));
		bottom: max(18px, env(safe-area-inset-bottom));
		z-index: 50;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.social-link {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border: 1px solid #ffffff40;
		border-radius: 50%;
		color: #fff;
		box-shadow: 0 4px 16px #253d4633;
		transition: transform .2s, box-shadow .2s;
	}

	.instagram { background: var(--color-wood); }
	.whatsapp { background: #18794e; }

	.social-link:hover {
		transform: translateY(-3px);
		box-shadow: 0 7px 20px #253d464d;
	}

	@media (max-width: 760px) {
		.floating-socials { gap: 8px; }
		.social-link {
			width: 44px;
			height: 44px;
		}
		.instagram svg { width: 21px; height: 21px; }
		.whatsapp svg { width: 23px; height: 23px; }
	}

	@media (min-width: 761px) {
		.floating-socials {
			right: max(28px, env(safe-area-inset-right));
			bottom: max(28px, env(safe-area-inset-bottom));
		}
	}
</style>
