---
import { site } from "../config/site";
import Icon from "./Icon.astro";
---

<header class="navbar site-navbar">
	<a class="brand" href="#inicio" aria-label={`${site.name}, inicio`}>
		<img
			class="brand-logo"
			src="/images/logo-navbar.webp"
			alt="Posada El Nómada"
		/>
	</a>
	<nav aria-label="Navegación principal">
		<a href="#posada">La posada</a>
		<a href="#experiencia">La experiencia</a>
		<a href="#ubicacion">Cómo llegar</a>
	</nav>
	<a
		class="btn btn-outline nav-cta"
		href={site.bookingUrl}
		target="_blank"
		rel="noreferrer">Reservar <Icon name="arrow-up-right" size={14} /></a
	>
</header>

<style>
	.site-navbar {
		height: 70px;
		padding: 0 6%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		background: #f5f0e6;
		color: #253d46;
		position: relative;
		z-index: 2;
	}
	.brand {
		display: flex;
		align-items: center;
		text-decoration: none;
		color: inherit;
	}
	.brand-logo {
		display: block;
		width: 104px;
		height: auto;
		max-height: 60px;
		object-fit: contain;
		object-position: left center;
		opacity: 0.88;
		filter: blur(0.35px) saturate(0.82) drop-shadow(0 3px 7px #29272555);
		transition:
			opacity 0.2s,
			filter 0.2s;
	}
	.brand:hover .brand-logo {
		opacity: 1;
		filter: blur(0) saturate(0.95) drop-shadow(0 4px 9px #29272566);
	}
	.site-navbar nav {
		display: none;
		gap: clamp(20px, 3vw, 38px);
	}
	.site-navbar nav a {
		position: relative;
		padding-block: 8px;
		font-size: 12px;
		text-decoration: none;
		color: inherit;
		transition: color 0.2s;
	}
	.site-navbar nav a::after {
		position: absolute;
		right: 0;
		bottom: 2px;
		left: 0;
		height: 1px;
		background: #a44832;
		content: "";
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.2s ease;
	}
	.site-navbar nav a:hover,
	.site-navbar nav a:focus-visible {
		color: #a44832;
	}
	.site-navbar nav a:hover::after,
	.site-navbar nav a:focus-visible::after {
		transform: scaleX(1);
	}
	.nav-cta {
		padding: 12px 14px;
		border-color: #a44832;
		color: #253d46;
		font-size: 10px;
		transition:
			color 0.2s ease,
			background-color 0.2s ease,
			border-color 0.2s ease,
			transform 0.2s ease;
	}
	.nav-cta:hover,
	.nav-cta:focus-visible {
		transform: translateY(-1px);
		border-color: #a44832;
		background: #a44832;
		color: #f5f0e6;
	}
	@media (min-width: 761px) {
		.site-navbar {
			height: 82px;
			padding: 0 3% 0 7%;
			width: 100%;
			max-width: none;
		}
		.brand-logo {
			width: 112px;
			max-height: 68px;
		}
		.site-navbar nav {
			display: flex;
		}
		.nav-cta {
			padding: 13px 18px;
			font-size: 11px;
		}
	}
</style>
