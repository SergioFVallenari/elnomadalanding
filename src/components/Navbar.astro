---
import { site } from '../config/site';
---

<header class="navbar site-navbar">
	<a class="brand" href="#inicio" aria-label={`${site.name}, inicio`}>
		<img class="brand-logo" src="/images/logo-navbar.webp" alt="Posada El Nómada" />
	</a>
	<nav aria-label="Navegación principal">
		<a href="#posada">La posada</a>
		<a href="#experiencia">La experiencia</a>
		<a href="#ubicacion">Cómo llegar</a>
	</nav>
	<a class="btn btn-outline nav-cta" href={site.bookingUrl} target="_blank" rel="noreferrer">Reservar <span aria-hidden="true">↗</span></a>
</header>

<style>
	.site-navbar{height:70px;padding:0 6%;display:flex;align-items:center;justify-content:space-between;background:#F5F0E6;color:#253D46;position:relative;z-index:2}
	.brand{display:flex;align-items:center;text-decoration:none;color:inherit}
	.brand-logo{display:block;width:104px;height:auto;max-height:60px;object-fit:contain;object-position:left center;opacity:.88;filter:blur(.35px) saturate(.82) drop-shadow(0 3px 7px #29272555);transition:opacity .2s,filter .2s}
	.brand:hover .brand-logo{opacity:1;filter:blur(0) saturate(.95) drop-shadow(0 4px 9px #29272566)}
	.site-navbar nav{display:none;gap:clamp(20px,3vw,38px)}
	.site-navbar nav a{font-size:12px;text-decoration:none;color:inherit;transition:opacity .2s}
	.site-navbar nav a:hover{opacity:.65}
	.nav-cta{padding:12px 14px;border-color:#A44832;color:#253D46;font-size:10px}
	@media(min-width:761px){.site-navbar{height:82px;padding:0 3% 0 7%;width:100%;max-width:none}.brand-logo{width:112px;max-height:68px}.site-navbar nav{display:flex}.nav-cta{padding:13px 18px;font-size:11px}}
</style>
